.git
.github
.venv
__pycache__
*.pyc
.DS_Store

# Frontend build/install output. Dockerfile.app runs npm ci inside the image.
app/node_modules
app/dist

# Runtime data is bind-mounted in production; keep it out of image contexts.
data/

# Large research/dev artifacts not needed by the production images.
archive/
docs/snapshot/
research/
fhir_explorer/
patient-journey/

# EHI Atlas production extraction only needs ehi-atlas/ehi_atlas plus the
# reference vocabulary slice. The PDF lab pipeline's loinc_matcher and the
# bundle packager's terminology slices both read from corpus/reference/
# at runtime, so it must reach the image. Heavy dev artifacts under
# corpus/_sources, corpus/bronze, etc. stay excluded.
ehi-atlas/corpus/_sources/
ehi-atlas/corpus/bronze/
ehi-atlas/corpus/silver/
ehi-atlas/corpus/gold/
ehi-atlas/notebooks/
ehi-atlas/notes/
ehi-atlas/app/
ehi-atlas/tests/
ehi-atlas/.claude/
ehi-atlas/.venv/
ehi-atlas/uv.lock

# Local/generated upload fixtures and scratch artifacts.
*.log
*.sqlite
*.db
*.db-*
