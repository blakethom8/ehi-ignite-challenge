# -----------------------------
# EHI Ignite API runtime config
# -----------------------------

# Required for Anthropic assistant mode.
ANTHROPIC_API_KEY=replace_with_real_key

# Assistant runtime mode:
# - deterministic
# - context
# - anthropic
PROVIDER_ASSISTANT_MODE=context

# If anthropic mode fails, fallback to deterministic assistant.
PROVIDER_ASSISTANT_FALLBACK_TO_DETERMINISTIC=true

# Anthropic runtime tuning
PROVIDER_ASSISTANT_MODEL=claude-sonnet-4-5
PROVIDER_ASSISTANT_MAX_TURNS=6
PROVIDER_ASSISTANT_MAX_RESPONSE_TOKENS=2000
PROVIDER_ASSISTANT_ALLOW_CLIENT_OVERRIDES=false
# Optional budget cap in USD, blank to disable
PROVIDER_ASSISTANT_MAX_BUDGET_USD=

# Web tools (keep off by default for clinical safety)
PROVIDER_ASSISTANT_ENABLE_WEB_SEARCH=false
PROVIDER_ASSISTANT_ENABLE_WEB_FETCH=false

# Optional environment tag
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ehi.healthcaredataai.com
ALLOWED_HOSTS=ehi.healthcaredataai.com,localhost,127.0.0.1,testserver

# Bootstrap account — auto-created on startup if no account exists with this
# email. In production the seeding is skipped entirely when
# EHI_AUTH_BOOTSTRAP_PASSWORD is empty.
# EHI_AUTH_BOOTSTRAP_EMAIL=clinician@atlas.local
# EHI_AUTH_BOOTSTRAP_NAME=Atlas Clinician
# EHI_AUTH_BOOTSTRAP_PASSWORD=
# Role assigned to the bootstrap account. Must be one of:
# consumer / clinician / attending / coordinator / admin. Default: clinician.
# Set to "admin" locally to access /admin/users on first boot.
# EHI_AUTH_BOOTSTRAP_ROLE=clinician

# Tracing / Observability
TRACING_ENABLED=false
TRACES_API_ENABLED=false
# Required if TRACES_API_ENABLED=true in production.
# TRACES_API_TOKEN=replace_with_random_token
# LANGFUSE_PUBLIC_KEY=pk_...
# LANGFUSE_SECRET_KEY=sk_...
# LANGFUSE_HOST=https://cloud.langfuse.com
