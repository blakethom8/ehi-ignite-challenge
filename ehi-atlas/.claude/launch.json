{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": ["run", "dev", "--prefix", "../app"],
      "port": 5173,
      "cwd": ".."
    },
    {
      "name": "API",
      "runtimeExecutable": "../.venv/bin/uvicorn",
      "runtimeArgs": ["api.main:app", "--reload", "--port", "8001"],
      "port": 8001,
      "cwd": ".."
    },
    {
      "name": "PDF Lab",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--with", "streamlit", "streamlit", "run", "app/streamlit_app.py", "--server.port", "8505", "--server.headless", "true"],
      "port": 8505
    }
  ]
}
