# Large ZIP files - don't commit
data/synthea-samples/*.zip
data/synthea-samples/synthea-r4-individual/
data/synthea-samples/sample-bulk-fhir-datasets-10-patients/*.ndjson
data/synthea-samples/sample-bulk-fhir-datasets-10-patients/log.ndjson

# Keep the folder structure
!data/synthea-samples/.gitkeep

# Node (Cursor sidecar)
cursor-sidecar/node_modules/
cursor-sidecar/dist/

# Python
__pycache__/
*.pyc
.env
venv/
.venv/
.DS_Store
lib/patient_catalog/.corpus_cache.json
__pycache__/
*.pyc
data/traces.db
data/traces.db-*
data/aggregation-uploads/
data/aggregation-profiles/
data/patient-context/
data/harmonization-runs/
data/harmonize-demo/
data/published-charts/
data/sof.db
data/sof.db-*
data/sof.db.tmp
data/sof_*.db
data/sof_*.db-*

# lib/extract — vision extraction cache (deterministic SHA-keyed; regenerable)
lib/extract/.cache/
lib/extract/.extraction-cache/

# Pitch / reviewer snapshot — intentionally committed (≤ 20 MB, 200 patients).
# Every other *.db under research/ should stay out of git.
research/*.db
research/*.db-*
!research/ehi-ignite.db

# pdf-review — scratch space for PDF parsing review.
# Per-PDF folders (e.g. pdf-review/cedars-myhealth/) hold the inputs and outputs.
# Real PDFs, parser outputs, and HAR logs may contain PHI — never commit those.
# scripts/, README.md, notes.md, and per-PDF notes.md ARE committed (the work product).
pdf-review/*/inputs/*
!pdf-review/*/inputs/.gitkeep
pdf-review/*/function-health-output/*
!pdf-review/*/function-health-output/.gitkeep
pdf-review/*/function-outputs/*
!pdf-review/*/function-outputs/.gitkeep
pdf-review/*/our-output/*
!pdf-review/*/our-output/.gitkeep
pdf-review/*/our-outputs/*
!pdf-review/*/our-outputs/.gitkeep
.DS_Store
